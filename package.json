{
  "name": "flow-steward-doc",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "dev": "docusaurus start",
    "start": "npm run build && docusaurus serve",
    "preview": "npm run build && docusaurus serve",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test": "node --test scripts/automation/*.test.mjs scripts/api-reference/*.test.mjs tests/*.test.mjs",
    "api-reference:sync": "node scripts/api-reference/sync.mjs",
    "api-reference:verify": "node scripts/api-reference/sync.mjs --verify",
    "prebuild": "npm run api-reference:verify",
    "build:release": "npm run api-reference:sync && npm run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-react": "5.35.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "serialize-javascript": "7.1.4",
    "uuid": "11.1.1",
    "@docusaurus/core": {
      "tinypool": "2.2.0"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
